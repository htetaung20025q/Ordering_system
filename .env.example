# ==============================================================================
# FLOW-SYS ORDERING SYSTEM — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting the application.
# NEVER commit the actual .env file with real secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# HOST PORT MAPPINGS
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
BACKEND_PORT=8000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (PostgreSQL)
# Used by docker-compose for the db service and backend connection string.
# ------------------------------------------------------------------------------
POSTGRES_DB=ordering_system
POSTGRES_USER=flowsys_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password_2026

# Internal Docker async connection URL (constructed automatically in docker-compose):
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# For standalone local development without Docker (SQLite default):
# DATABASE_URL=sqlite+aiosqlite:///./ordering_system.db

# ------------------------------------------------------------------------------
# SECURITY & AUTHENTICATION (JWT)
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret key for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_long_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# INITIAL STAFF & ADMINISTRATIVE CREDENTIALS (PRODUCTION GRADE)
# Configure production credentials before starting the application.
# Used on startup by seed_initial_data() to bootstrap and synchronize staff logins.
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@flowsys.com
ADMIN_PASSWORD=replace_with_a_strong_admin_password_2026
ADMIN_FULL_NAME=System Administrator

KITCHEN_USERNAME=kitchen
KITCHEN_EMAIL=kitchen@flowsys.com
KITCHEN_PASSWORD=replace_with_a_strong_kitchen_password_2026
KITCHEN_FULL_NAME=Chief Chef

MANAGER_USERNAME=manager
MANAGER_EMAIL=manager@flowsys.com
MANAGER_PASSWORD=replace_with_a_strong_manager_password_2026
MANAGER_FULL_NAME=Restaurant Manager

CUSTOMER_USERNAME=customer
CUSTOMER_EMAIL=customer@flowsys.com
CUSTOMER_PASSWORD=customer123
CUSTOMER_FULL_NAME=Jane Diner

# ------------------------------------------------------------------------------
# FINANCIAL & RESTAURANT SETTINGS
# ------------------------------------------------------------------------------
CURRENCY=MMK
CURRENCY_SYMBOL=MMK
DEFAULT_TAX_RATE=0.05
DEFAULT_SERVICE_CHARGE_RATE=0.10

# Database query logging (true for development, false for production)
DATABASE_ECHO=false
